# --- Database ---
# Any Postgres instance works — Neon, Supabase, Railway, or local.
DATABASE_URL="postgresql://user:password@host:5432/sakhivastra"

# --- Razorpay ---
# From https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxx"
# From Razorpay Dashboard > Account & Settings > Webhooks (only needed if you wire up /api/webhooks/razorpay)
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxx"

# --- Product Sync (Google Sheet) ---
# 1. Open your sheet -> Share -> "Anyone with the link" -> Viewer
# 2. Find the gid in your sheet's URL (the number after #gid= when you
#    click the tab at the bottom, e.g. "Sheet1"). Default tab is gid=0.
# 3. Build the URL as:
#    https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
GOOGLE_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/1VlSBPKyNc8CtCZvWh7YcKFREyLyAG4m6yMlt9AAJgw8/export?format=csv&gid=0"

# --- Shiprocket ---
# The email/password you use to log in to https://app.shiprocket.in
SHIPROCKET_EMAIL="you@example.com"
SHIPROCKET_PASSWORD="your-shiprocket-password"
# The exact "Pickup Location" nickname configured in Shiprocket > Settings > Pickup Addresses
SHIPROCKET_PICKUP_LOCATION_NAME="Primary"
